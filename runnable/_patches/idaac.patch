+def observation_level_seed(info, done):
+    """Return the episode identity for the observation emitted by a VecEnv step.
+
+    OpenAI Baselines' DummyVecEnv auto-resets a completed environment: on ``done`` the returned
+    observation is the next episode's reset observation while ``info`` still came from the
+    terminal transition. EpisodeLevelSeed records both identities so callers cannot silently tag
+    that reset observation with the episode that just ended.
+    """
+    key = "next_level_seed" if done else "level_seed"
+    if key not in info:
+        raise KeyError(f"IDAAC step info is missing {key!r} for done={bool(done)}")
+    return info[key]
+
+
+def observation_level_seeds(infos, dones):
+    """Vector form used by IDAAC's rollout collector."""
+    if len(infos) != len(dones):
+        raise ValueError(f"infos/dones length mismatch: {len(infos)} != {len(dones)}")
+    return [observation_level_seed(info, bool(done)) for info, done in zip(infos, dones)]
