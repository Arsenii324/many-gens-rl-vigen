+class EpisodeLevelSeed(gym.Wrapper):
+    """Give each RL-ViGen episode the instance identity required by IDAAC."""
+
+    def __init__(self, env, level_seed, condition_seed=None, scene_id=0, level_stride=1):
+        super().__init__(env)
+        self._level_seed_base = level_seed
+        self._level_stride = level_stride
+        self._level_seed = level_seed
+        self._condition_seed = condition_seed
+        self._scene_id = scene_id
+        self._episode_index = 0
+
+    def reset(self, **kwargs):
+        self._level_seed = self._level_seed_base + self._episode_index * self._level_stride
+        if self._condition_seed is not None:
+            condition = int(np.random.SeedSequence(
+                [int(self._condition_seed), int(self._scene_id), self._episode_index]
+            ).generate_state(1, dtype=np.uint32)[0])
+            np.random.seed(condition)
+        self._episode_index += 1
+        return self.env.reset(**kwargs)
+
+    def step(self, action):
+        obs, rew, done, info = self.env.step(action)
+        info["level_seed"] = self._level_seed
+        if done:
+            # DummyVecEnv calls reset immediately after this method returns. The next reset uses
+            # exactly this index, and its observation replaces the terminal observation.
+            info["next_level_seed"] = (
+                self._level_seed_base + self._episode_index * self._level_stride)
+        return obs, rew, done, info
