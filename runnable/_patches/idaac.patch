+    venv = DummyVecEnv([(lambda i=i: _one(i)) for i in range(num_envs)])
+    if not bases:
+        raise RuntimeError("RL-ViGen adapter constructed no environments")
+    applied_regime = {
+        "mode": getattr(bases[0], "_mode", None),
+        "scene_id": getattr(bases[0], "_scene_id", None),
+        "video_background": getattr(bases[0], "video_background", None),
+    }
+    if applied_regime["mode"] is None:
+        raise RuntimeError(
+            "RL-ViGen adapter could not read the applied regime off the constructed env: "
