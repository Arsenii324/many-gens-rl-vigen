+# ---------------------------------------------------------------------------------------------
+# CONTINUOUS HEAD. This file is a cut-down of ikostrikov/pytorch-a2c-ppo-acktr-gail
+# (a2c_ppo_acktr/distributions.py @ 41332b7) -- `init`, `FixedCategorical` and `Categorical`
+# above are byte-identical to it. IDAAC dropped the Box branch because Procgen is discrete.
+#
+# Everything below is COPIED VERBATIM from that same upstream file, not written here. That is
+# the point: RL-ViGen's Box(-1,1,(7,)) action space needs the branch this file already had a
+# lineage for. `AddBias` sits in the upstream's utils.py rather than here; it is placed next to
+# its only caller so the change stays in one file. Its body is unmodified.
+# ---------------------------------------------------------------------------------------------
+class FixedNormal(torch.distributions.Normal):
+    def log_probs(self, actions):
+        return super().log_prob(actions).sum(-1, keepdim=True)
+
+    def entropy(self):
+        return super().entropy().sum(-1)
+
+    def mode(self):
+        return self.mean
+
+
+class AddBias(nn.Module):
+    def __init__(self, bias):
+        super(AddBias, self).__init__()
+        self._bias = nn.Parameter(bias.unsqueeze(1))
+
+    def forward(self, x):
+        if x.dim() == 2:
+            bias = self._bias.t().view(1, -1)
+        else:
+            bias = self._bias.t().view(1, -1, 1, 1)
+
+        return x + bias
+
+
+class DiagGaussian(nn.Module):
+    def __init__(self, num_inputs, num_outputs):
+        super(DiagGaussian, self).__init__()
+
+        init_ = lambda m: init(m, nn.init.orthogonal_, lambda x: nn.init.
+                               constant_(x, 0))
+
+        self.fc_mean = init_(nn.Linear(num_inputs, num_outputs))
+        self.logstd = AddBias(torch.zeros(num_outputs))
+
+    def forward(self, x):
+        action_mean = self.fc_mean(x)
+
+        #  An ugly hack for my KFAC implementation.
+        zeros = torch.zeros(action_mean.size())
+        if x.is_cuda:
+            zeros = zeros.cuda()
+
+        action_logstd = self.logstd(zeros)
+        return FixedNormal(action_mean, action_logstd.exp())
