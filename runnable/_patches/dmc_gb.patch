+# [Claude 2026-09-02 03:55 MSK: endpoint hook for the native DataSphere contract.
+# This repository's loop evaluates and checkpoints only inside `if done:`, and only when the step
+# divides `eval_freq` / `save_freq`. `save_freq` defaults to 100k, so a 10k or 100k run finishes
+# with NO checkpoint at all, and an endpoint that does not divide the cadence gets no final
+# evaluation either. This hook runs AFTER the unchanged loop: it takes no environment step, runs
+# no update, touches no seed, and re-uses this file's own `evaluate` and the same
+# `torch.save(agent, ...)` the loop uses. It skips the evaluation when the loop already evaluated
+# at exactly this step, so it never double-counts.
+# ENABLES-class by the repository's own taxonomy (setup/apply_patches.py): it changes the
+# measurement and retention protocol, not the learning.]
+def finalize_run(env, test_env, agent, video, L, args, model_dir, last_eval_step):
+	if last_eval_step != args.train_steps:
+		evaluate(env, agent, video, args.eval_episodes, L, args.train_steps)
+		if test_env is not None:
+			evaluate(test_env, agent, video, args.eval_episodes, L, args.train_steps, test_env=True)
+		L.dump(args.train_steps)
+	terminal_checkpoint = os.path.join(model_dir, f'{args.train_steps}.pt')
+	if not os.path.exists(terminal_checkpoint):
+		torch.save(agent, terminal_checkpoint)
+	print(f'NATIVE_FINAL_EVALUATION_COMPLETED frame={args.train_steps}', flush=True)
+
+
