+class _RGBOnly(gym.ObservationWrapper):
+	"""RL-ViGen's robosuite env returns {'rgb': (3,84,84) uint8}; this repo's stack expects an
+	array. Gym2DMC does the same unwrap for RL-ViGen's own dm_control-style consumers."""
+	def __init__(self, env, max_episode_steps):
+		super().__init__(env)
+		shp = env.observation_space['rgb'].shape
+		self.observation_space = gym.spaces.Box(low=0, high=255, shape=shp, dtype=np.uint8)
+		# FrameStack reads this; robosuite does not expose it and gym blocks private passthrough.
+		# Taken from train.py's own --episode_length rather than invented.
+		self._max_episode_steps = max_episode_steps
+
+	def observation(self, obs):
+		return obs['rgb']
