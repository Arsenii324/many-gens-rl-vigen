diff --git a/src/train.py b/src/train.py
index 793eb15..b6598a4 100644
--- a/src/train.py
+++ b/src/train.py
@@ -13,22 +13,33 @@ from video import VideoRecorder
 
 def evaluate(env, agent, video, num_episodes, L, step, test_env=False):
 	episode_rewards = []
+	# SUCCESS RATE (added for RL-ViGen; see docs/PART2-METRIC-INVENTORY.md). Door's return is
+	# dense and scale-arbitrary, so it compares to nothing outside itself; robosuite's own
+	# _check_success is sparse, task-defined and unit-free. RL-ViGen patch P10 puts it in `info`.
+	# CONVENTION, chosen here and stated because it is a real choice: an episode counts as a
+	# success if _check_success held at ANY step. The alternative -- the flag at the LAST step,
+	# which is what RL-ViGen's own habitat path uses -- differs whenever a policy achieves the
+	# goal and then loses it, which on Door means opening the door and letting it swing back.
+	# Empty dict fallback keeps DMC domains, which have no such key, working unchanged.
 	for i in range(num_episodes):
 		obs = env.reset()
 		video.init(enabled=(i==0))
 		done = False
 		episode_reward = 0
+		succeeded = False
 		while not done:
 			with utils.eval_mode(agent):
 				action = agent.select_action(obs)
-			obs, reward, done, _ = env.step(action)
+			obs, reward, done, info = env.step(action)
 			video.record(env)
 			episode_reward += reward
+			succeeded = succeeded or bool((info or {}).get('success', False))
 
 		if L is not None:
 			_test_env = '_test_env' if test_env else ''
 			video.save(f'{step}{_test_env}.mp4')
 			L.log(f'eval/episode_reward{_test_env}', episode_reward, step)
+			L.log(f'eval/success_rate{_test_env}', float(succeeded), step)
 		episode_rewards.append(episode_reward)
 	
 	return np.mean(episode_rewards)
