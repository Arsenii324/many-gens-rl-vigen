+def get_robosuite_venv(*, env_id, num_envs, seed=0, scene_id=0, mode="train", **_ignored):
+    """RL-ViGen robosuite as a gym3 venv. `_ignored` swallows procgen-only kwargs."""
+    import os, sys, gym
+    _rlv = os.environ["RLVIGEN_ROOT"]
+    for _p in (_rlv, os.path.join(_rlv, "envs", "robosuiteVGB")):
+        if _p not in sys.path:
+            sys.path.insert(0, _p)
+    from robosuitevgb.utils import make_env as _robo_make_env
+
+    class _HWCUint8(gym.ObservationWrapper):
+        """RL-ViGen yields {'rgb': (C,H,W) uint8} under a float64 Box it never fills.
+        ImpalaCNN takes (H,W,C) and gym3 typechecks against the space, so fix both."""
+        def __init__(self, env):
+            super().__init__(env)
+            c, h, w = env.observation_space["rgb"].shape
+            self.observation_space = gym.spaces.Box(0, 255, (h, w, c), dtype=np.uint8)
+
+        def observation(self, obs):
+            return np.asarray(obs["rgb"], dtype=np.uint8).transpose(1, 2, 0)
+
+        def seed(self, seed=None):
+            "gym3.FromGymEnv calls this unconditionally; RL-ViGen's `seed` is an int attribute,"
+            "not a method, and the env is already seeded by make_env(seed=...) above."
+            return []
+
+    return gym3.ConcatEnv([
+        gym3.FromGymEnv(_HWCUint8(_robo_make_env(
+            task_name=env_id, seed=seed + i, scene_id=scene_id, mode=mode)))
+        for i in range(num_envs)
+    ])
+
 def get_venv(num_envs, env_name, **env_kwargs):
+    if env_name.startswith("robosuite:"):
+        return get_robosuite_venv(
+            env_id=env_name.split(":", 1)[1], num_envs=num_envs, **env_kwargs)
     venv = get_procgen_venv(num_envs=num_envs, env_id=env_name, **env_kwargs)
 
     return venv
