+from vec_env import ProcgenVecEnvCustom, RLViGenVecEnvCustom
+
+# [OURS] C61/C28 policy-health diagnostics, shared with `idaac`, `ibac_sni` and `ppg` through
+# scripts/metrics.py so the four continuous PPO-family baselines report one quantity rather than
+# four near-misses of it. Loaded by path: this clone runs with its own directory as the root and
+# `scripts` is not importable from inside it.
+#
+# CTRL is the most exposed of the four. `models.py:179` does `jnp.exp(self.log_std)` with NO
+# clamp -- `ppg` clips to [-5, 2], `idaac` normalises advantages against the entropy term -- while
+# its own entropy coefficient was tuned on Procgen's 15-way categorical, whose entropy is bounded
+# by ln 15. Here it multiplies a 7-D Gaussian's, which is unbounded above. Nothing in `Eprew200`
+# distinguishes a policy that is exploring from one dissolving into saturated noise.
+import importlib.util as _ilu
+import pathlib as _pl
+from collections.abc import Mapping as _Mapping
+_spec = _ilu.spec_from_file_location(
+    "_vigen_metrics", _pl.Path(__file__).resolve().parents[1].parent / "scripts" / "metrics.py")
+_m = _ilu.module_from_spec(_spec)
+_spec.loader.exec_module(_m)
+_policy_health = _m.gaussian_policy_health
+
+
+def _find_log_std(tree):
+    """Depth-first search of the flax param tree for the `log_std` leaf.
+
+    By name rather than by path because the tree's shape differs between CTRLModel and
+    CTRLDAACModel, and a hardcoded path would return None on one of them -- silently, which is
+    the failure mode that leaves a diagnostic looking present and reporting nothing.
+    """
+    if isinstance(tree, _Mapping):
+        for key, value in tree.items():
+            if key == "log_std":
+                return value
+            found = _find_log_std(value)
+            if found is not None:
+                return found
+    return None
 
 
