+class RLViGenVecEnvCustom():
+    """RL-ViGen robosuite behind the SAME VecEnv stack ProcgenVecEnvCustom uses.
+
+    Interface parity with ProcgenVecEnvCustom is the whole design: `observation_space`,
+    `action_space`, `reset()`, `step()`, `_max_episode_steps`. VecMonitor and VecNormalize are
+    the copies vendored in THIS file, so episode bookkeeping and reward normalisation are the
+    same code on both paths -- only the env underneath differs.
+
+    `observation_space` is declared (C, H, W) while the data is (H, W, C), which looks wrong and
+    is not: ProcgenVecEnvCustom does exactly the same, and buffer.py compensates with
+    `state_shape = [shape[1], shape[2], shape[0]]`. Matching the existing convention is what
+    keeps buffer.py untouched.
+
+    `mode` is RL-ViGen's visual regime (train / eval-easy / eval-medium / eval-hard), standing in
+    for Procgen's num_levels / start_level split.
+    """
+
+    def __init__(self, env_name, mode="train", num_envs=8, seed=0, scene_id=0,
+                 normalize_rewards=True, **_ignored):
+        import sys
+        _rlv = os.environ["RLVIGEN_ROOT"]
+        for _p in (_rlv, os.path.join(_rlv, "envs", "robosuiteVGB")):
+            if _p not in sys.path:
+                sys.path.insert(0, _p)
+        from robosuitevgb.utils import make_env as _robo_make_env
+
+        task = env_name.split(":", 1)[1] if ":" in env_name else env_name
+        envs = [_robo_make_env(task_name=task, seed=seed + i, scene_id=scene_id, mode=mode)
+                for i in range(num_envs)]
+        c, h, w = envs[0].observation_space["rgb"].shape
+
+        self.observation_space = Box(shape=(c, h, w), low=0, high=255)
+        self.action_space = envs[0].action_space
+
+        env = _SyncVecEnv(envs, self.observation_space, self.action_space)
+        env = VecMonitor(venv=env, filename=None, keep_buf=100)
+        if normalize_rewards:
+            env = VecNormalize(venv=env, ob=False)
+        self.env = env
+        self._max_episode_steps = 10_000
+
+    def reset(self):
+        return self.env.reset()
+
+    def step(self, action):
+        o, r, d, info = self.env.step(np.asarray(action))
+        return o, r, d, info
+
+
+class _SyncVecEnv(VecEnv):
+    """The minimum VecEnv over a list of gym envs: step them in order, auto-reset on done.
+
+    ProcgenEnv is already vectorised, so this file never needed a vectoriser and does not ship
+    one; baselines' DummyVecEnv is not importable from here. Written rather than borrowed, and
+    kept to the three abstract methods VecEnv declares. Auto-reset-on-done matches what
+    ProcgenEnv does internally, which is what VecMonitor's episode accounting assumes.
+    """
+
+    def __init__(self, envs, observation_space, action_space):
+        self.envs = envs
+        VecEnv.__init__(self, len(envs), observation_space, action_space)
+        self._actions = None
+
+    @staticmethod
+    def _obs(o):
+        # (C,H,W) uint8 -> (H,W,C), the layout ProcgenEnv yields after VecExtractDictObs.
+        return np.asarray(o["rgb"], dtype=np.uint8).transpose(1, 2, 0)
+
+    def reset(self):
+        return np.stack([self._obs(e.reset()) for e in self.envs])
+
+    def step_async(self, actions):
+        self._actions = actions
+
+    def step_wait(self):
+        obs, rews, dones, infos = [], [], [], []
+        for e, a in zip(self.envs, self._actions):
+            o, r, d, i = e.step(a)
+            if d:
+                o = e.reset()
+            obs.append(self._obs(o)); rews.append(r); dones.append(d); infos.append(i)
+        return (np.stack(obs), np.array(rews, dtype=np.float32),
+                np.array(dones, dtype=bool), infos)
