+# RL-ViGen robosuite Door. A new spec is this repo's OWN configuration mechanism -- it ships one
+# spec per task -- so this adds a file rather than modifying one. `domain_name: robosuite` selects
+# the branch added to alda_trainer.initialize_env_dmc.
+name: alda_robosuite_door
+trainer:
+  class: ALDA
+  module: trainers.alda_trainer
+  config:
+    seed: 0
+    batch_size: 128
+    num_latents: 12
+    values_per_latent: 12
+    beta: 100
+    n_train_steps: 500_000
+    # [Claude 2026-09-05] Declared explicitly at ALDA's OWN default (trainers/alda_trainer.py:73)
+    # so behaviour is unchanged, but the cadence becomes reachable. Two reasons it must be:
+    #   1. `parse_spec_overrides` only accepts keys ALREADY PRESENT in the spec, so a key absent
+    #      here cannot be set from the command line -- job bt1nmsbsf7u1o4618eks failed with
+    #      "Spec override key not found: trainer.config.checkpoint_n_steps" for exactly this.
+    #   2. `families.json` records alda's production `save_every: 50000` as "its own cadence ...
+    #      unchanged". That is true only because this default happens to equal the desired value;
+    #      nothing plumbed it, so a production run at any other cadence would silently not apply.
+    # With the key declared, `--spec.trainer.config.checkpoint_n_steps=N` works and the descriptor
+    # can pass {save_every} like every other family.
+    checkpoint_n_steps: 50_000
+    # Declared for the same reason and at ALDA's own default (alda_trainer.py:72). The descriptor
+    # passes --spec.trainer.config.eval_n_steps={eval_every}; without the key present here that
+    # override is rejected and EVERY alda cell dies at startup, which is how job
+    # bt1763ukgansn5t7t5tv failed with "Spec override key not found: trainer.config.eval_n_steps".
+    eval_n_steps: 10_000
+    env:
+      domain_name: robosuite
+      task_name: Door
+      frame_stack: 3
+      # DEAD KNOB (C71 #2): never read on the robosuite path. `trainers/alda_trainer.py`'s
+      # `domain_name == 'robosuite'` branch returns before the `dmc2gym.make(...,
+      # frame_skip=env_config['action_repeat'])` that is its only consumer. Effective value is 1
+      # because nothing repeats, not because of this line.
+      action_repeat: 1
+      episode_length: 500
+      scene_id: 0
