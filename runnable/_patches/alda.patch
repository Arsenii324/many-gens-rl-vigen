+class _RoboRGB(gym.ObservationWrapper):
+    """RL-ViGen robosuite returns {'rgb': (3,H,W) uint8}; FrameStack wants an array.
+
+    `_max_episode_steps` is read by FrameStack and robosuite does not expose it (gym blocks
+    private passthrough), so it is taken from the spec's own `episode_length` rather than invented.
+    """
+    def __init__(self, env, max_episode_steps):
+        super().__init__(env)
+        self.observation_space = gym.spaces.Box(
+            low=0, high=255, shape=env.observation_space['rgb'].shape, dtype=np.uint8)
+        self._max_episode_steps = max_episode_steps
+
+    def observation(self, obs):
+        return obs['rgb']
