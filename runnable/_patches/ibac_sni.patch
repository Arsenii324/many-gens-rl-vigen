+
+def make_rlvigen_env(env_id, seed):
+    """RL-ViGen robosuite as a plain gym env, in the shape this repo's own preprocessor expects.
+
+    `utils.get_obss_preprocessor` already has a generic branch for `Box([H, W, 3])` -- written
+    for RGB envs, unused by MiniGrid -- so nothing about preprocessing needs changing; the
+    wrapper just has to present that shape. RL-ViGen yields {'rgb': (3,H,W) uint8}.
+
+    THE ONE DELIBERATE SCALING CHOICE: `utils.format.preprocess_images` does
+    `torch.tensor(images, dtype=torch.float)` with NO division. That is correct for MiniGrid,
+    whose "image" is small category indices, and wrong for 0-255 RGB -- inputs two orders of
+    magnitude off what `initialize_parameters` assumes. Division by 255 therefore happens HERE,
+    in the seam, rather than by editing the repo's preprocessor. Declared, not silent: every
+    other baseline in this project feeds pixels in [0,1] too.
+
+    `mode` comes from RLVIGEN_MODE so train / eval-easy / eval-medium / eval-hard select the
+    visual regime without a new CLI flag.
+
+    `scene_id` comes from RLVIGEN_SCENE_ID the same way, and for the same reason. It was hardcoded
+    to 0, which is exactly the shape [C45](../../../../docs/CONSTRUCTION.md#c45) describes -- the
+    protocol and the benchmark both say ten scenes and seven of the twelve baselines pin one. An
+    env var rather than a parameter because the callers are the clone's own scripts and a new
+    argument would mean editing them; this keeps the deviation inside the seam that already exists.
+    Default 0, so every existing caller is unchanged.
+    """
+    import os, sys, gym, numpy as np
+    _rlv = os.environ["RLVIGEN_ROOT"]
+    for _p in (_rlv, os.path.join(_rlv, "envs", "robosuiteVGB")):
+        if _p not in sys.path:
+            sys.path.insert(0, _p)
+    from robosuitevgb.utils import make_env as _robo_make_env
+
+    class _HWCFloat(gym.ObservationWrapper):
+        def __init__(self, env):
+            super().__init__(env)
+            c, h, w = env.observation_space["rgb"].shape
+            self.observation_space = gym.spaces.Box(0.0, 1.0, (h, w, c), dtype=np.float32)
+
+        def observation(self, obs):
+            return (np.asarray(obs["rgb"], dtype=np.float32).transpose(1, 2, 0) / 255.0)
+
+        def seed(self, seed=None):
+            "The env is seeded at construction; RL-ViGen's own `seed` is an int attribute."
+            return []
+
+    task = env_id.split(":", 1)[1]
+    try:
+        scene_id = int(os.environ.get("RLVIGEN_SCENE_ID", "0"))
+    except ValueError:
+        raise ValueError(
+            "RLVIGEN_SCENE_ID=%r is not an integer; a scene axis that silently falls back to 0 "
+            "would report a one-scene number as a ten-scene sweep"
+            % os.environ.get("RLVIGEN_SCENE_ID"))
+    return _HWCFloat(_robo_make_env(
+        task_name=task, seed=seed, scene_id=scene_id,
+        mode=os.environ.get("RLVIGEN_MODE", "train")))
