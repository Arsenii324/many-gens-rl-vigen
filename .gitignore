# Vendored upstream — 1.8 GB. Provenance and install in setup/VENDORED.md.
/RL-ViGen-upstream/

__pycache__/
*.py[cod]
.DS_Store
.venv/
*.egg-info/

# Run outputs. Per-episode logs are the deliverable, but they are large and
# regenerable; publish them deliberately, do not commit them by accident.
/runs/
/logs/
/wandb/
*.pt
*.pth
artifacts/

# robosuite writes a scene dump into the cwd on some code paths
/door.xml
/lift.xml

# Per-project downloads: cloned reference repos and papers. Read-only, re-fetchable,
# and NOT ours to version. See projects/README.md.
/ext/

# The Places365 overlay dataset. ~36.5k images, re-fetchable by setup/fetch_overlay_dataset.sh,
# and it must never be committed -- it was, and it is why .git is ~480 MB.
/data/
.greenmark

# Cloned originals: ~200MB each, each with its own .git. Reproducible from ext/ plus
# runnable/_patches/<name>.patch, which IS tracked -- so the complete change set is in version
# control while the clone is not. `python scripts/deviations.py --export` regenerates them.
runnable/*/
!runnable/_shim/
!runnable/_launch/
!runnable/_patches/

# ---------------------------------------------------------------------------
# [Claude 2026-09-04] APPENDED for the recovery workspace. Everything above is
# the authored file from the versioned original, restored verbatim: I had
# overwritten it with a weaker rewrite (hardcoding six clone names instead of
# `runnable/*/` plus negations, and dropping /data/, /wandb/, .greenmark and
# *.pth) before reading it. Only the lines below are mine.
#
# These cover artifacts that did not exist when the original was written,
# because the datasphere/native job infrastructure postdates it.

# Job payloads: ~113 MB each, regenerated by `contract.py build-payload`.
datasphere/native/payload-*.tgz
*.tgz

# Returned job archives and the flax/msgpack checkpoints inside them.
*.jd
*.npz
/results/

# The pinned upstream is already ignored above; third_party/ is fetched the same way.
/third_party/
