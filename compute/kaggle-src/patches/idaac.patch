+def make_rlvigen_venv(args, device, mode, num_envs):
+    """RL-ViGen robosuite behind the SAME VecEnv stack ProcgenEnv gets.
+
+    baselines' own DummyVecEnv replaces ProcgenEnv; VecMonitor / VecNormalize(ob=False) /
+    VecPyTorchProcgen are then applied unchanged, so episode bookkeeping, reward normalisation
+    and the tensor conversion are the authors' code on both paths. VecExtractDictObs is dropped
+    because the wrapper below already yields a bare array, exactly what it would have produced.
+
+    `mode` is RL-ViGen's train / eval-easy / eval-medium / eval-hard.
+    """
+    import os, sys
+    from baselines.common.vec_env import DummyVecEnv, VecMonitor, VecNormalize
+    _rlv = os.environ["RLVIGEN_ROOT"]
+    for _p in (_rlv, os.path.join(_rlv, "envs", "robosuiteVGB")):
+        if _p not in sys.path:
+            sys.path.insert(0, _p)
+    from robosuitevgb.utils import make_env as _robo_make_env
+
+    class _RGBOnly(gym.ObservationWrapper):
+        """{'rgb': (3,H,W) uint8} under a float64 Box RL-ViGen never fills -> a real uint8 Box.
+        VecPyTorchProcgen reads observation_space.low[0,0,0], so the declared dtype matters."""
+        def __init__(self, env):
+            super().__init__(env)
+            self.observation_space = Box(
+                0, 255, env.observation_space["rgb"].shape, dtype=np.uint8)
+
+        def observation(self, obs):
+            return np.asarray(obs["rgb"], dtype=np.uint8)
+
+    class _LevelSeed(gym.Wrapper):
+        """Supplies info['level_seed'], which Procgen provides and IDAAC's own mechanism needs.
+
+        IDAACRolloutStorage.before_update pairs each observation with another one carrying the
+        SAME level_seed and asks the order classifier which came first -- that is IDAAC's
+        instance-invariance signal, so this key is not bookkeeping, it defines what "the same
+        instance" means here. An RL-ViGen env's visual instance is fixed by its seed at
+        construction, so the seed IS the level id.
+
+        DIFFERENT FROM PROCGEN, and it bears on IDAAC specifically: a Procgen env draws a new
+        level every episode, so one rollout spans many instances; here each env is one instance
+        for the whole run, and instance diversity per batch is capped at num_processes.
+        Recorded, not silently equated -- it is a Part 2 comparability question.
+        """
+        def __init__(self, env, level_seed):
+            super().__init__(env)
+            self._level_seed = level_seed
+
+        def step(self, action):
+            obs, rew, done, info = self.env.step(action)
+            info["level_seed"] = self._level_seed
+            return obs, rew, done, info
+
+    task = args.env_name.split(":", 1)[1]
+    venv = DummyVecEnv([
+        (lambda i=i: _LevelSeed(_RGBOnly(_robo_make_env(
+            task_name=task, seed=args.seed + i, scene_id=0, mode=mode)), args.seed + i))
+        for i in range(num_envs)
+    ])
+    venv = VecMonitor(venv=venv, filename=None, keep_buf=100)
+    venv = VecNormalize(venv=venv, ob=False)
+    return VecPyTorchProcgen(venv, device)
